# XAM-XAM LAB — configuration serveur (aucune valeur n'est exposée au navigateur).
# --- Base de données : PostgreSQL 16 (DATABASE_URL) ou, à défaut, PGlite embarqué dans PGLITE_DIR (./data/pglite).
DATABASE_URL=
PGLITE_DIR=
POSTGRES_PASSWORD=            # docker compose uniquement
# --- Sécurité (OBLIGATOIRE en production) : secret de session ≥ 32 caractères aléatoires (openssl rand -base64 48).
SESSION_SECRET=
# Adresses des administrateurs (séparées par des virgules) : seul moyen d'obtenir le rôle administrateur.
XX_ADMIN_EMAILS=
INSECURE_COOKIES=false        # true seulement pour un essai local en HTTP
# --- XAM-XAM AI CORE : sans clé, le moteur de règles répond (signalé comme tel).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=200
# --- Moteurs de calcul Python (pvlib, CoolProp) : interpréteur avec workers/requirements.txt installé.
XX_PYTHON=python3
# --- Prévisions Meteomatics (compte XAM-XAM LAB requis). NASA POWER : public, sans clé.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
# --- Visioconférence : STUN/TURN (sans TURN, appels garantis seulement au sein d'un même réseau).
XX_STUN_URLS=
XX_TURN_URLS=
XX_TURN_USERNAME=
XX_TURN_CREDENTIAL=
# --- Passerelle MQTT (npm run mqtt) : URL de la plateforme, ports, TLS.
XX_PLATFORM_URL=http://localhost:3100
MQTT_PORT=1883
MQTTS_PORT=
MQTT_TLS_CERT=
MQTT_TLS_KEY=
MQTT_ALLOW_INSECURE=false
# --- Proxy d'entreprise éventuel pour les appels sortants.
HTTPS_PROXY=
